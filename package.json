{
  "name": "nlb-shared-view",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Today/Tomorrow view of NLB seat and room bookings, pushed from the logged-in NLB page to a Cloudflare Worker.",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p push/tsconfig.json",
    "predev": "npm run build",
    "dev": "wrangler dev",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "init-secrets": "node scripts/init-secrets.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
